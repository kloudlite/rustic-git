#!/bin/sh
# TMPDIR (Dockerfile ENV) is a private dir under the shared /tmp emptyDir: /tmp itself is 0777 with
# no sticky bit.
mkdir -p -m 0700 "$TMPDIR"
# The tmux server, in the foreground so runsv supervises it. `-D` takes no command (tmux 3.3a
# rejects `-D new …`), so tmux.conf creates the `kl` session running the graphcode TUI; if it
# exits, the next ttyd or ssh login recreates it (`new -A`).
exec tmux -D -f /etc/kl/tmux.conf

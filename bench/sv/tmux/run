#!/bin/sh
# Skip the agent CLI's first-run theme picker: the home volume is new, and nobody is attached to
# answer it before the pane starts.
[ -f ~/.claude.json ] || echo '{"hasCompletedOnboarding":true}' > ~/.claude.json
# The tmux server, in the foreground so runsv supervises it. `-D` takes no command (tmux 3.3a
# rejects `-D new …`), so tmux.conf creates the `kl` session running the agent CLI; if the CLI
# exits, the next ttyd or ssh login recreates it (`new -A`).
exec tmux -D -f /etc/kl/tmux.conf

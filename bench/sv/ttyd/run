#!/bin/sh
# -W: writable (keys reach the shared tmux session). Loopback only: bench/term/main.ts is the
# front door on 7681 (image paste) and the only client. `new -A`, same as sshd's ForceCommand:
# attach, or recreate the session if the graphcode TUI exited.
exec ttyd -W -i 127.0.0.1 -p 7682 tmux new -A -s kl bun /opt/kl/harness/apps/tui/src/cli.tsx

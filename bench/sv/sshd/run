#!/bin/sh
# One host key per bench, generated once into the home volume so it survives a restart (a new key
# every boot would make every known_hosts entry stale).
mkdir -p ~/.ssh-host
[ -f ~/.ssh-host/ed25519 ] || ssh-keygen -q -t ed25519 -N '' -f ~/.ssh-host/ed25519
# sshd does not hand its own environment to a login, so kl-tui -> ssh -> serve.ts saw no KL_API_URL /
# KL_TOOL_TOKEN_FILE and every platform tool answered "unavailable". This script DOES have the pod env
# (crates/workspaces/src/k8s/bench.rs), so SetEnv forwards the KL_* names: the pod spec stays the one
# list, as workspaces' login_env does (k8s/secrets.rs). KL_CLIP still comes from the client via
# AcceptEnv: a different name, so neither overrides the other.
exec /usr/sbin/sshd -D -e -f /etc/kl/sshd_config -o "SetEnv=$(env | grep '^KL_' | tr '\n' ' ')"

# sshd for a bench pod: every login runs its own graphcode TUI through its dev script
# (ForceCommand), authenticated against the owner's own key (AuthorizedKeysFile, projected by the
# agent from OwnerKeys — see crates/workspaces/src/k8s/attach.rs). No password, no PAM: the only
# credential is the key the gateway already fenced BENCH_PORT to.
Port 7789
HostKey /home/kl/.ssh-host/ed25519
AuthorizedKeysFile /etc/kloudlite/authorized_keys
PasswordAuthentication no
UsePAM no
PidFile none
# ForceCommand is an allow-list (bench/term/login-shell): the empty command runs the TUI,
# `claude-login` runs `claude auth login`, anything else is refused. The COLORTERM note (ssh does
# not forward it; without it opentui drops to 256 colours) lives in that script.
ForceCommand /opt/kl/term/login-shell
# ForceCommand alone does not stop `ssh -N -L/-D`: a key holder would get a SOCKS pivot from the
# bench pod's network position (final review I2), so -L/-D, agent and X11 forwarding stay off. The
# one forward allowed is `-R` of a unix socket: a socket on the bench pointing back at the caller's
# own laptop (kl-connect's clipboard, bins/kl-connect/src/clip.rs), created owner-only (default
# StreamLocalBindMask 0177). It reaches nothing the key holder could not already reach. KL_CLIP
# names that socket for the xclip shim (bench/term/xclip). AllowUsers names the only account
# OwnerKeys ever authenticates as.
# Not `AllowTcpForwarding no`: sshd gates a unix-socket -R on the TCP remote switch too (session.c
# do_authenticated, "XXX - streamlocal?"), so `no` denied the clipboard socket. `remote` plus
# `PermitListen none` refuses every TCP -R, and PermitListen never applies to a socket path
# (channels.c remote_open_match).
AllowTcpForwarding remote
PermitListen none
AllowAgentForwarding no
X11Forwarding no
AllowStreamLocalForwarding remote
# The pod's own KL_* variables are not accepted from the client: bench/sv/sshd/run sets them with
# `-o SetEnv=` from the pod env. Only KL_CLIP (the caller's clipboard socket) is client-supplied.
AcceptEnv KL_CLIP
PermitTunnel no
AllowUsers kl

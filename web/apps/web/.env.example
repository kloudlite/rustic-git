# Auth.js — copy to .env.local and fill in.
# AUTH_SECRET: generate with `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# The hosts the Clone menu and the registry pages print. Required in production — a wrong
# value hands out commands that point at somebody else's site; a dev server says localhost.
RUSTIC_GIT_CLONE_HOST=localhost:8080
RUSTIC_GIT_SSH_HOST=localhost
RUSTIC_GIT_SSH_PORT=2222
RUSTIC_GIT_REGISTRY_HOST=localhost:8080

# Each provider is registered only when both of its values are set; an
# unconfigured provider is hidden from the sign-in page rather than erroring.
#
# Callback URLs to register with each provider:
#   GitHub     http://localhost:3000/api/auth/callback/github
#   Google     http://localhost:3000/api/auth/callback/google
#   Microsoft  http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Email + password sign-in, for a deployment with no OAuth provider yet. Both are
# required for it to exist at all; the address must be listed AND the password
# must match. Not a bypass — it is a real credential check on a production build.
AUTH_ALLOWED_EMAILS=
AUTH_SHARED_PASSWORD=


{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // `.ts` in a relative import: the node test runner resolves an extension, vite is happy either
    // way, and without it a module the tests load cannot import a sibling at all.
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  },
  "include": ["src/renderer", "src/preload.ts"]
}

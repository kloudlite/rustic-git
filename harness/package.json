{
  "name": "kloudlite-harness",
  "version": "0.0.0",
  "private": true,
  "main": "dist/src/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "bench:test": "node --test --test-concurrency=4 'bench/test/*.test.ts' && npm run test:components",
    "test:components": "NODE_OPTIONS='--conditions=browser' vitest run --config vitest.config.ts bench/test/operations-components.test.tsx bench/test/operations-integration-components.test.tsx",
    "bench:start": "node bench/src/main.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-undici": "0.32.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "lucide-solid": "^1.45.0",
    "marked": "^18.0.13",
    "solid-js": "^1.9.0",
    "typebox": "1.3.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "electron": "^42.11.5",
    "fast-sha256": "^1.3.0",
    "happy-dom": "18.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "3.2.4"
  }
}

/target
# Local-run scratch: per-node caches and generated SSH host keys.
# Unanchored: a test that runs with its CWD inside a crate writes `crates/<x>/.local/cache`, not
# just the root one. Anchored as `/.local` it was not ignored, and a `git add -A` committed two
# SlateDB .sst files into the repo.
.local/
# Explicit custody marker for reviewer-only evaluation bundles (also covered by `.local/`).
/.local/evaluation-oracles/
# Personal ops runbook with cluster-specific commands; not for the repo.
/RUNBOOK.local.md
# Older runs wrote these at the root; keep ignoring strays — at the root only.
/cache*
/host_key*

# web
web/node_modules
web/**/node_modules
web/**/.next
web/.turbo
/.turbo

# k3s provisioning parameters (may name an operator IP; never secrets)
deploy/k3s/env.sh
# ClickStack's own user passwords (`hyperdx.secrets.*`, `default` user): generated on the operator's
# laptop, passed to `helm upgrade` as a second -f, recoverable from the release secret if lost.
deploy/clickstack/secrets.yaml

# kubectl writes a discovery/http cache next to whatever KUBECONFIG points at; 28 of these
# files were committed once. They are regenerated on every kubectl call.
/.kube/
__pycache__/

# Crash dumps a test binary leaves in the checkout; never a source file.
core
core.[0-9]*

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
harness/node_modules

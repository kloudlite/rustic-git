# The node controller's image.
#
# Separate from the root Dockerfile on purpose: that one builds the three deployed server binaries
# and runs them as uid 1001 with no capabilities. This one runs as root and carries btrfs-progs,
# because the agent's whole job is calling `btrfs` against the host pool. Sharing an image would
# mean shipping root's toolchain to the three processes that must never have it.
#
# Build context is the repo root:
#   docker build -f deploy/k3s/Dockerfile.agent -t rustic-git-agent:dev .
FROM rust:1-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY crates ./crates
COPY bins ./bins
COPY tests ./tests
RUN cargo build --release --locked -p rustic-git-agent-bin

FROM debian:bookworm-slim
# btrfs-progs: every storage operation shells out to it.
# util-linux: `losetup`/`mount` for the block-layer restore path.
# ca-certificates: the registry client and Azure blob store speak TLS.
RUN apt-get update && apt-get install -y --no-install-recommends \
      btrfs-progs util-linux ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/rustic-git-agent /usr/local/bin/rustic-git-agent
# Root, deliberately and unlike every other image here: btrfs subvolume operations on the host pool
# are not something a capability set can be narrowed to.
ENTRYPOINT ["rustic-git-agent"]
